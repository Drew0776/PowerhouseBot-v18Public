# The image installs its own dependencies (npm ci) and builds its own dist.
# Host node_modules would overwrite them with binaries built for the host,
# not Alpine (better-sqlite3 is native), and local data would be baked in.
node_modules
dist
.git
*.db
*.db-shm
*.db-wal
.env
.env.*
!.env.example
.agents
.claude
