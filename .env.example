# Alpaca Paper Trading — set your own keys (https://alpaca.markets/)
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=

# Telegram Alerts (optional — set up via Settings page)
# TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
# TELEGRAM_CHAT_ID=your_chat_id_from_userinfobot

# Operator login (required — the dashboard and API are behind this password)
OPERATOR_PASSWORD=
# Session cookie signing key; set a long random string so logins survive restarts
SESSION_SECRET=

# Server
NODE_ENV=production
PORT=5000
